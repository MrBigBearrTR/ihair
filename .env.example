# ============================================================
# iHair - Environment Variable Şablonu
# Bu dosyayı .env olarak kopyala ve gerçek değerlerle doldur:
#   cp .env.example .env
# ============================================================

# Neon PostgreSQL (neon.tech → Connect → JDBC formatı seç)
DATABASE_URL=jdbc:postgresql://ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your-neon-password-here

# JWT (en az 64 karakter, güçlü rastgele string kullan)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-characters

# Opsiyonel (belirtilmezse varsayılan değerler kullanılır)
# JWT_ACCESS_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000

# Spring profili (prod = Neon bağlantısı aktif)
SPRING_PROFILES_ACTIVE=prod
